{
  "name": "opensam",
  "version": "2.0.0",
  "private": true,
  "description": "OpenSAM — Open-source autonomous agent platform for SAM.gov federal contracting. Type-safe SDK, scoring engine, and full web app.",
  "license": "MIT",
  "author": "AliceLabs LLC <legal@alicelabs.site> (https://alicelabs.site)",
  "homepage": "https://github.com/eddyflores100-lang/OpenSAM",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddyflores100-lang/OpenSAM.git"
  },
  "bugs": {
    "url": "https://github.com/eddyflores100-lang/OpenSAM/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf packages/*/dist apps/*/dist node_modules",
    "dev": "npm run dev --workspace apps/web --if-present",
    "start:pilot": "node apps/server/server.mjs",
    "test:pilot": "node --test apps/server/test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.19.0",
    "eslint": "^10.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2"
  },
  "keywords": [
    "sam-gov",
    "federal-contracting",
    "govtech",
    "procurement",
    "naics",
    "ai-agent",
    "typescript",
    "open-source",
    "alice-labs"
  ],
  "overrides": {
    "minimatch": "^11.0.8",
    "postcss-selector-parser": "^6.1.5"
  }
}
